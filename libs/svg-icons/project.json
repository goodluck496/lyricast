{
  "name": "svg-icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/svg-icons/src",
  "prefix": "lyri",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/svg-icons/jest.config.ts",
        "tsConfig": "libs/svg-icons/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/libs/svg-icons",
        "tsConfig": "libs/svg-icons/tsconfig.lib.json",
        "main": "libs/svg-icons/src/index.ts",
        "assets": ["libs/svg-icons/icons/*.svg"]
      }
    }
  }
}
