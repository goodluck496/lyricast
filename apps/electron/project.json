{
  "name": "electron",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/electron/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx-electron:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/electron",
        "main": "apps/electron/src/main.ts",
        "tsConfig": "apps/electron/tsconfig.app.json",
        "assets": [
          "apps/electron/src/assets"
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/electron/src/environments/environment.ts",
              "with": "apps/electron/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "node tools/build-workers.mjs --watch"
          },
          {
            "command": "nx run electron:serve-original"
          }
        ],
        "parallel": true
      }
    },
    "serve-original": {
      "executor": "nx-electron:execute",
      "options": {
        "buildTarget": "electron:build"
      }
    },
    "prepare-workers": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "songs-service",
            "bible-service",
            "free-slide-service"
          ],
          "target": "build"
        }
      ],
      "options": {
        "commands": [
          {
            "command": "node tools/sync-workers.mjs"
          }
        ]
      }
    },
    "bundle-workers": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "node tools/build-workers.mjs"
          }
        ]
      }
    },
    "package": {
      "executor": "nx-electron:package",
      "dependsOn": [
        {
          "projects": "self",
          "target": "build"
        },
        {
          "projects": "self",
          "target": "bundle-workers"
        }
      ],
      "options": {
        "name": "electron",
        "frontendProject": "browser",
        "sourcePath": "dist/apps",
        "outputPath": "dist/packages",
        "prepackageOnly": true,
        "platform": "windows"
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "electron",
        "frontendProject": "browser",
        "sourcePath": "dist/apps",
        "outputPath": "dist/executables"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/electron/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/electron/jest.config.ts"
      }
    }
  }
}
