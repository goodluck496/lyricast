{
  "name": "dict-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "lyri",
  "sourceRoot": "apps/dict-client/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/dict-client",
        "browser": "apps/dict-client/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/dict-client/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": [
            ".",
            "libs"
          ]
        },
        "baseHref": "./",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/dict-client/public"
          }
        ],
        "styles": [
          "apps/dict-client/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "options": {
        "port": 0
      },
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dict-client:build:production"
        },
        "development": {
          "buildTarget": "dict-client:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "dict-client:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/dict-client/jest.config.ts",
        "tsConfig": "apps/dict-client/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "dict-client:build",
        "staticFilePath": "dist/apps/dict-client/browser",
        "spa": true
      }
    },
    "openapi:gen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm openapi-generator-cli generate -c tools/openapi/openapi-gen.config.yml",
        "cwd": "."
      }
    }
  }
}
