    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.44.7",
    "electron-log": "^5.3.0",
    "imask": "^7.6.1",
    "lodash-es": "^4.17.21",
    "luxon": "^3.6.1",
    "ng2-fittext": "^2.0.0",
    "ngx-scrollbar": "^16.1.1",
    "piscina": "^5.1.3",
    "pixi.js": "^8.14.0",
    "png-to-ico": "^3.0.1",
    "primeicons": "^6.0.1",
    "primeng": "^17.18.12",
    "quill": "^2.0.3",
