{
  "name": "song-usage-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/workers/song-usage-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/workers/song-usage-service"],
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/workers/song-usage-service",
        "args": ["--node-env=production"],
        "command": "webpack-cli build"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "song-usage-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "song-usage-service:build:development"
        },
        "production": {
          "buildTarget": "song-usage-service:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/workers/song-usage-service/jest.config.ts"
      }
    }
  }
}
