  "main": "./dist/apps/electron/main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && npm run __rebuild:better-sqlite",
    "_build:browser": "nx run browser:build:production",
    "_build:electron": "nx run electron:build:production",
    "_package:electron": "nx run electron:package",
    "_build:backend": "nx run backend:build",
    "_start:backend": "nx run backend:serve",
    "_browser:serve": "nx run browser:serve",
    "_start:browser": "npm-run-all -c _wait-on-start:backend _browser:serve",
    "_wait-on-start:browser": "wait-on -v  http://localhost:4200",
    "_wait-on-start:backend": "wait-on -v  http://localhost:3000/api/ok",
    "_electron:serve": "nx run electron:serve",
    "_start:electron": "npm-run-all -c _wait-on-start:browser _electron:serve",
    "start": "npm-run-all -p _start:backend _start:browser _start:electron",
    "build": "npm-run-all -c _build:browser _build:backend _build:electron _package:electron",
    "build-with-backend": "npm-run-all -c build _start:backend",
    "parseSong": "ts-node parse-song-from-html.ts",
    "__build-win-32": "electron-builder --windows nsis:ia32",
    "__rebuild:better-sqlite": "cd node_modules/better-sqlite3 && node-gyp rebuild",
    "__copy-package-to-dist": "copy package.json dist/win-ia32-unpacked/resources/backend/",
    "forge:start": "electron-forge start",
    "forge:package": "electron-forge package",
    "forge:make": "electron-forge make"
  },
