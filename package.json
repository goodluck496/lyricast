{
  "name": "LyriCast",
  "version": "2.4.1",
  "main": "./dist/apps/electron/main.js",
  "description": "Casting bible, songs and other to projector",
  "author": "goodluck496 <nikita.a.kalinin@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npm run _start:browser\" \"npm run _start-all-workers\" \"npm run _start:electron\" --kill-others --force-kill-after 5000",
    "build-win:prepare-npm-node-modules": "node tools/prepare-npm-node-modules.mjs",
    "build-win-PNPM": "npm-run-all -c build-win:prepare-npm-node-modules 01__build-win 02__build-win",
    "build-win": "npm-run-all -c 01__build-win 02__build-win",
    "build-win-with-archive": "npm-run-all -c build-win:prepare-npm-node-modules 01__build-win 02__build-win  03__build-win",
    "noop0": "---  build section  ---",
    "build": "npm-run-all -c build:browser _build:electron _build:electron-workers",
    "01__build:browser": "npm run __generate-icons",
    "02__build:browser": "npm run _build:browser",
    "_build:browser": "nx run browser:build:production",
    "build:browser": "npm-run-all -c 01__build:browser 02__build:browser",
    "_build:electron": "nx run electron:build:production",
    "_package:electron": "nx run electron:package",
    "_build:dictionary-client": "nx run dictionary-client:build:production",
    "noop0.1": "---  workers build block  ---",
    "songs-worker:build": "nx run songs-service:build",
    "bible-worker:build": "nx run bible-service:build",
    "free-slide-worker:build": "nx run free-slide-service:build",
    "asset-worker:build": "nx run asset-service:build",
    "quiz-worker:build": "nx run quiz-service:build",
    "_build:electron-workers": "nx run-many --target=build --projects=songs-service,bible-service,free-slide-service,asset-service,quiz-service --parallel=3 --configuration=production",
    "_prepare:electron-workers": "nx run electron:prepare-workers",
    "noop0.2": "---  DEPRECATED workers build block  ---",
    "noop0.3": "--- build for win section  ---",
    "01__build-win": "npm run build",
    "02__build-win": "npm run __build-win-32",
    "03__build-win": "npm run __zip-dist win ||  node -e \"process.exit(0)\"",
    "noop0.4": "--- build for linux section  ---",
    "01__build-linux": "npm run build",
    "02__build-linux": "npm run __build-win-32",
    "03__build-linux": "npm run __zip-dist linux ||  node -e \"process.exit(0)\"",
    "noop1": "---  serve section  ---",
    "_browser:serve": "nx run browser:serve",
    "_start:browser": "npm-run-all -c  _browser:serve",
    "_wait-on-start:browser": "wait-on -v  http://localhost:4200",
    "_electron:serve": "nx run electron:serve",
    "_start:electron": "npm-run-all -c _wait-on-start:browser _electron:serve ",
    "_start-all-workers": "concurrently \"npm run songs-worker:build:watch\" \"npm run bible-worker:build:watch\" \"npm run free-slide-worker:build:watch\" \"npm run asset-worker:build:watch\" \"npm run quiz-worker:build:watch\" --kill-others --force-kill-after 5000",
    "_dictionary-client:serve": "nx run dictionary-client:serve",
    "noop1.1": "---  workers Serve block ---",
    "songs-worker:serve": "nx run songs-service:serve",
    "bible-worker:serve": "nx run bible-service:serve",
    "free-slide-worker:serve": "nx run free-slide-service:serve",
    "asset-worker:serve": "nx run asset-service:serve",
    "quiz-worker:serve": "nx run quiz-service:serve",
    "noop1.2": "---  workers build block with WATCH ---",
    "songs-worker:build:watch": "nx run songs-service:build --watch",
    "bible-worker:build:watch": "nx run bible-service:build --watch",
    "free-slide-worker:build:watch": "nx run free-slide-service:build --watch",
    "asset-worker:build:watch": "nx run asset-service:build --watch",
    "quiz-worker:build:watch": "nx run quiz-service:build --watch",
    "noop2": "--- tools section  ---",
    "__parseSong": "ts-node parse-song-from-html.ts",
    "__build-win-32": "electron-builder --windows nsis:ia32",
    "__build-linux:docker": "docker build -t lyricast-linux-builder . && docker run --rm -v $(pwd):/project lyricast-linux-builder",
    "__build-linux:wsl": "bash tools/build-linux.sh",
    "__build-linux": "electron-builder --linux --x64",
    "__zip-dist": "node tools/zip-dist-7z.mjs",
    "__generate-icons": "svg-to-ts-files",
    "__rebuild:better-sqlite": "echo '@deprecated - cd node_modules/better-sqlite3 && node-gyp rebuild '",
    "__openapi:songs:client:gen": "pnpm nx run dictionary-client:openapi:songs:gen",
    "__openapi:songs:backend:gen": "pnpm nx run songs-service:openapi:gen",
    "noop3": "--- postinstall section  ---",
    "_postinstall-electron--install-deps": "electron-builder install-app-deps",
    "_postinstall-electron--rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm-run-all -c _postinstall-electron--install-deps _postinstall-electron--rebuild",
    "noop4": "--- BUILD ICON APP ---",
    "create-app-icons": "electron-icon-maker --input=assets\\build\\icons\\lyriicon.png --output=assets\\build\\icons\\builded",
    "build-app-icon": "npx png-to-ico  assets\\build\\icons\\builded\\icons\\png\\1024x1024.png > assets\\build\\icons\\builded\\icon.ico",
    "noop5": "---  FOR DATABASES  ---",
    "db:generate-free-slide": "drizzle-kit generate --config=drizzle.config.free-slide.ts",
    "db:generate-asset": "drizzle-kit generate --config=drizzle.config.asset.ts",
    "noop6": "---   build bible translates  ---",
    "bible-translates:build": "ts-node tools\\bible-from-sqllite.parser.ts",
    "noop7": "---   DEPRECATED, not using  ---",
    "forge:start": "electron-forge start",
    "forge:package": "electron-forge package",
    "forge:make": "electron-forge make",
    "build:apps": "npm-run-all -c build:browser _build:electron",
    "dist:electron": "electron-builder -c tools/electron-builder.config.js",
    "publish:electron": "electron-builder -c tools/electron-builder.config.js -p always"
  },
  "private": true,
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@actions/exec": "^1.1.1",
    "@angular/animations": "20.3.13",
