{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    "outDir": "../../../../dist/apps/electron/workers",
    "module": "CommonJS",
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "moduleResolution": "Node",
    "noEmit": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "**/*.worker.ts",
    "../../../../libs/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
