{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@lyri-cast/*": ["libs/*/src/index.ts"],
      "@lyri-cast/asset-domain": ["libs/domains/asset-domain/src/index.ts"],
      "@lyri-cast/asset-management": [
        "libs/features/asset-management/src/index.ts"
      ],
      "@lyri-cast/assets": [
        "libs/shared-browser/data-access/assets/src/index.ts"
      ],
      "@lyri-cast/bible-domain": ["libs/domains/bible-domain/src/index.ts"],
      "@lyri-cast/bible-feature": ["libs/features/bible-feature/src/index.ts"],
      "@lyri-cast/bible-store": [
        "libs/shared-browser/store/bible-store/src/index.ts"
      ],
      "@lyri-cast/common": ["libs/common/src/index.ts"],
      "@lyri-cast/common-browser": ["libs/common-browser/src/index.ts"],
      "@lyri-cast/common-electron": ["libs/common-electron/src/index.ts"],
      "@lyri-cast/common-workers": ["libs/common-workers/src/index.ts"],
      "@lyri-cast/data-access-bible": [
        "libs/shared-browser/data-access/bible/src/index.ts"
      ],
      "@lyri-cast/data-access-songs": [
        "libs/shared-browser/data-access/songs/src/index.ts"
      ],
      "@lyri-cast/entities": ["libs/entities/src/index.ts"],
      "@lyri-cast/form": ["libs/features/forms/src/index.ts"],
      "@lyri-cast/free-slide": [
        "libs/shared-browser/data-access/free-slide/src/index.ts"
      ],
      "@lyri-cast/data-access-dictionaries": [
        "libs/shared-browser/data-access/dictionaries/src/index.ts"
      ],
      "@lyri-cast/free-slide-domain": [
        "libs/domains/free-slide-domain/src/index.ts"
      ],
      "@lyri-cast/free-slide-feature": [
        "libs/features/free-slide-feature/src/index.ts"
      ],
      "@lyri-cast/free-slide-store": [
        "libs/shared-browser/store/free-slide-store/src/index.ts"
      ],
      "@lyri-cast/navigator-feature": [
        "libs/features/navigator-feature/src/index.ts"
      ],
      "@lyri-cast/search-feature": [
        "libs/features/search-feature/src/index.ts"
      ],
      "@lyri-cast/song-feature": ["libs/features/song-feature/src/index.ts"],
      "@lyri-cast/quiz-feature": ["libs/features/quiz/src/index.ts"],
      "@lyri-cast/song-store": [
        "libs/shared-browser/store/song-store/src/index.ts"
      ],
      "@lyri-cast/songs-domain": ["libs/domains/songs-domain/src/index.ts"],
      "@lyri-cast/styles": ["libs/styles/src/index.ts"],
      "@lyri-cast/svg-icons": ["libs/svg-icons/src/index.ts"],
      "@lyri-cast/svg-icons/*": ["libs/svg-icons/src/*"],
      "@lyri-cast/ui-lib": ["libs/ui-lib/src/index.ts"],
      "@lyri-cast/worker-kit": ["libs/worker-kit/src/index.ts"],
      "@lyri-cast/quiz-domain": ["libs/domains/quiz-domain/src/index.ts"],
      "@lyri-cast/data-access-quiz": ["libs/shared-browser/data-access/quiz/src/index.ts"],
      "@lyri-cast/openapi-client": ["libs/openapi-client/generated/index.ts"],
    }
  },
  "references": [
    {
      "path": "apps/workers/bible-service"
    },
    {
      "path": "libs/domains/bible-domain"
    }
  ],
  "exclude": ["node_modules", "tmp"]
}
